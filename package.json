{
  "name": "data-santri",
  "productName": "Data Santri",
  "version": "1.0.0",
  "description": "Aplikasi desktop offline untuk mengelola data santri pondok pesantren.",
  "author": "Sekretaris Pondok",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "26.0.13",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "id.pondok.datasantri",
    "productName": "Data Santri",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DataSantri-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DataSantri-Portable-${version}.exe"
    }
  }
}
